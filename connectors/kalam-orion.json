{
  "id": "kalam-orion",
  "name": "kalam-orion",
  "connector_type": "http",
  "tags": ["pkg:kalam"],
  "config": {
    "type": "http",
    "url": "env://KALAM_ORION_ADMIN",
    "headers": {
      "content-type": "application/json",
      "user-agent": "kalam-roster",
      "authorization": "env://ORION_ADMIN_BEARER"
    },
    "retry": { "max_retries": 0, "retry_delay_ms": 0 },
    "timeout_ms": 15000,
    "allow_private_urls": true
  }
}
