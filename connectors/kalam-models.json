{
  "id": "kalam-models",
  "name": "kalam-models",
  "connector_type": "storage",
  "tags": ["pkg:kalam"],
  "config": {
    "type": "storage",
    "provider": "s3",
    "endpoint": "env://MODELS_ENDPOINT",
    "region": "auto",
    "bucket": "env://MODELS_BUCKET",
    "access_key": "env://MODELS_READ_ACCESS_KEY",
    "secret_key": "env://MODELS_READ_SECRET_KEY",
    "operations": { "presign_get": true, "presign_put": false, "head": true },
    "force_path_style": true
  }
}
