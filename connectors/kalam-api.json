{
  "id": "kalam-api",
  "name": "kalam-api",
  "connector_type": "http",
  "tags": ["kalam", "conn", "platform"],
  "config": {
    "type": "http",
    "url": "env://KALAM_API_URL",
    "headers": { "content-type": "application/json", "user-agent": "kalam-runner" },
    "retry": { "max_retries": 3, "retry_delay_ms": 500 },
    "timeout_ms": 15000,
    "allow_private_urls": "var://allow_private_urls"
  }
}
