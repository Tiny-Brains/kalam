# The engine, which this image takes from the cartridge's own release. Copying a local build in
# would let it shadow the one the Dockerfile fetches -- which means the ladder plays a component
# ants does not ship. `channels/` and `workflows/` are SOURCE now, not build output, so the
# Dockerfile copies them from the context and they must not be excluded.
plugins/

.git/
.run/
__pycache__/

# The runner's local settings and signatures are not an input to the image.
.env
keys/
