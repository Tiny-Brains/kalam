# A TinyBrains runner.
#
#   cp .env.example .env
#   docker compose up -d
#
# Everything here except ORION_ADMIN_KEY is copied FROM the deployment. Nothing here is a database
# credential, a bucket secret, or an admin token for the platform -- a runner holds none of those,
# which is the reason it can be on a desk at all.

# ---- what makes this machine a runner ---------------------------------------------------------
# Minted on the admin Runners screen. SHOWN ONCE. Revoking it
# there stops this machine within one token lifetime (ten minutes).
RUNNER_KEY=tbr_...
# How this machine appears on the Runners screen. Two machines sharing a key are two rows, told
# apart by this and nothing else, so make it the machine's name.
RUNNER_LABEL=mac-mini

# ---- the platform, as seen from here ----------------------------------------------------------
# The Soma this runner plays for. https:// in any real deployment -- this is where the claim, the
# lease and the result go.
SOMA_URL=https://tinybrains.dev
# The models bucket, public-read, as addressed from HERE.
MODELS_ENDPOINT=https://models.tinybrains.dev
# The replay bucket, as addressed from HERE, and it MUST EQUAL Soma's RUNNER_BLOB_ENDPOINT. SigV4
# signs the host: a URL signed for one address and sent to another is SignatureDoesNotMatch, a 403
# that names neither setting.
RUNNER_BLOB_ENDPOINT=https://replays.tinybrains.dev

# ---- copied from the deployment ---------------------------------------------------------------
# The plugin trust key, and the signatures directory RUNNER_SIG_DIR names (./keys/signatures by
# default). Without both, the engine fails verification and this container refuses to come up.
TB_TRUST_PUBLIC_KEY=
#RUNNER_SIG_DIR=./keys/signatures
# A key that can GET models/* on a public-read bucket and do nothing else.
MODELS_READ_ACCESS_KEY=
MODELS_READ_SECRET_KEY=

# WHICH ENGINE THIS RUNNER PLAYS. PIN IT under a live season: `latest` moves when a new release is
# published, and a runner whose engine is not the one Soma declared claims nothing, for ever, while
# looking perfectly healthy.
#KALAM_IMAGE=ghcr.io/tiny-brains/kalam:1.0.0

# ---- this machine's own -----------------------------------------------------------------------
# NOT the deployment's admin key. It authorises the package load and the roster clock's calls to
# 127.0.0.1, both of which stay on this machine.
#   openssl rand -hex 32
ORION_ADMIN_KEY=

# ---- capacity ---------------------------------------------------------------------------------
# Matches at once, across every channel. Start at 2 and watch the lease renewals before raising it:
# each in-flight match holds two model sessions in memory.
RUNNER_CRON_WORKERS=2
# The model cache on this machine's disk, and what may be resident at once. The Docker VM must be
# larger than their SUM or the runner thrashes on every eviction. 4 GiB + 2 GiB.
RUNNER_MAX_CACHE_BYTES=4294967296
RUNNER_MAX_LOADED_BYTES=2147483648

# ---- against web's local stack, on this machine -----------------------------------------------
# Every address below is this machine's, so they are private, and the runner has to be told that is
# expected. Copy TB_TRUST_PUBLIC_KEY and the MODELS_READ_* pair from web's .env, and point
# RUNNER_SIG_DIR at web's keys/signatures.
#SOMA_URL=http://host.docker.internal:8080
#MODELS_ENDPOINT=http://host.docker.internal:9000
#RUNNER_BLOB_ENDPOINT=http://host.docker.internal:9000
#RUNNER_SIG_DIR=../web/keys/signatures
#RUNNER_ALLOW_PRIVATE_URLS=1
