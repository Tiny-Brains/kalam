# RETIRED, AND KEPT FOR ONE REASON. No image and no compose file runs a `db`-mode replica since N25:
# this repository ships a runner, configured by docker/runner.toml.tmpl, and the image does not copy
# this file. The package still carries its `db` branch until N10 deletes it, and web's
# scripts/check/configs.sh holds this file in step with Soma's template so that branch is not a
# rollback to numbers nobody kept. Delete this file, that check's §1c and the branch together.
#
# Orion config for a KALAM REPLICA: the wave, and nothing else. Requires 1.8.1. The Soma half is
# soma.toml.tmpl.
#
# One of these per replica, and NO [cluster] block: a shared `forbid` row would make the wave a
# fleet-wide singleton, so exactly one replica would ever play while the other N-1 polled a held
# row looking perfectly healthy. Kalam's fence is the leased claim on `matches`, not Orion's, so
# nothing is lost. scripts/check/configs.sh asserts the absence.

[server]
host = "0.0.0.0"
port = 8080

# NO data_mounts: a replica binds no route, it is cron only -- which is what the drain numbers turn
# on. drain is an unconditional FIXED sleep, so it buys a routeless node nothing; force is the REAL
# outer bound on a draining wave, because the cron worker is a supervised task and the server key
# is its deadline. A scale-down costs one WAVE, not one timeout.
shutdown_drain_secs         = ${ORION_SHUTDOWN_DRAIN_SECS:-5}
shutdown_force_timeout_secs = ${ORION_SHUTDOWN_FORCE_SECS:-2700}

# Disposable: the state holds the loaded package and nothing else, and everything that matters is
# in Postgres. No volume is mounted over it, so losing it costs one package load.
[storage]
url = "sqlite:${ORION_STATE_PATH:-/var/lib/orion/state.db}"
auto_migrate = true

[vars]
# The engine this replica plays, and the only rows its match clock may claim. DERIVED by
# entrypoint.sh from the component in the package volume, never typed: a literal that agrees with
# nothing is silent everywhere -- the clock claims nothing, for ever, and the replica looks healthy
# doing it.
engine_digest = "${KALAM_ENGINE_DIGEST}"

# WHERE THE EIGHT STATEMENTS RUN. `db` holds KALAM_DB_URL and runs them here, which is how an
# in-cluster replica has always worked. `api` calls /v1/runner/* instead and holds NO DATABASE
# CREDENTIAL -- which is the whole point, because it is what lets a replica run on hardware outside
# the deployment. The two paths are one task list gated on this value.
#
# In `api` almost nothing below this line is read: every number a match is played under arrives on
# the claim, from the one place that owns it. What the runner still needs is a key, a label and its
# own engine digest.
mode = "${KALAM_MODE:-db}"

# THE RUNNER'S CREDENTIAL, and the whole of what a machine needs to play matches: no connection
# string, no bucket secret, no admin token. Minted from the admin UI, or by
# scripts/dev/runner-key.sh on a dev stack. Exchanged for a ten-minute `aud: runner` token, so the
# key itself is presented once per refresh and never accompanies a match write.
runner_key   = "${KALAM_RUNNER_KEY:-}"
# WHICH MACHINE THIS IS. The gate upserts a `runners` row on (key_id, label), so a runner
# self-registers rather than being enrolled: two machines on one key are two rows, and the label is
# what tells them apart on the Runners screen.
#
# NO NESTED DEFAULT. `${A:-${B}}` is not substituted as one expression here -- the inner `}` closes
# the outer reference and the literal `}` is left on the value, which registers a runner called
# `kalam-2}`. Found the first time this ran. A deployment sets the name it wants.
runner_label = "${KALAM_RUNNER_LABEL:-kalam}"
# Reported at token exchange and never enforced -- it answers "what is that machine" and nothing
# else. The cartridge is wasm32, so the engine digest does NOT vary by host architecture.
#
# DERIVED by entrypoint.sh from `uname -m`, under the same name a standalone runner uses: it is a
# fact about the machine, not about the role. It used to default to `amd64` and every replica on
# this arm64 laptop reported amd64 on the Runners screen -- a label that lies in exactly the
# situation the screen exists for.
arch         = "${RUNNER_ARCH}"
node_version = "${KALAM_NODE_VERSION:-dev}"

# ONE MATCH PER RUN (decision R7). Every Ants map is two-player, so a wave of K rows existed to
# amortise one batched inference call across many seats -- a number that is two. Concurrency is now
# concurrent runs of tb-match, bounded by cron.max_concurrent_runs below.
match_concurrency = 4

renew_every_n_turns = 30
lease_seconds       = 300

turn_ms   = 1000
max_turns = 1000

# How often a row may be refused because this node cannot serve a seat's model before it fails as
# MODEL_UNAVAILABLE. Counted apart from lease lapses, because they mean different things: a lapse is
# a crash, a refusal is a roster that has not caught up.
#
# THE STRIKE CEILING IS DELIBERATELY NOT HERE. Pair stamps matches.strike_ceiling from the season
# (decision 54) and the match clock reads it off the row, so a trial is judged by the rule it was
# played under. scripts/check/configs.sh fails if this file grows one back.
refusal_ceiling = 5

replay_prefix = "replays"
blob_endpoint = "${R2_ENDPOINT}"
poll_secs = 5

# What the roster clock tells this node its models are called and where their bytes are. The model
# id is derived from the version id (R9) and never stored: `tb.v` plus the uuid.
model_prefix  = "tb.v"
models_bucket_connector = "kalam-models"

# What ran the adapters, recorded on every match this replica finishes. MUST EQUAL the soma node's
# `orion_version`, which is the same ORION_VERSION the image was built from -- a match recorded
# against one Orion and admitted against another is exactly what a re-validation sweep looks for.
orion_version = "${ORION_VERSION:-1.8.1}"

[admin_auth]
enabled = true
api_keys = ["${ORION_ADMIN_KEY}"]

[plugins]
enabled = true

# THE CARTRIDGE IS THE ONE PLACE A THIRD PARTY'S CODE ENTERS THE PLATFORM, so this list must stay
# non-empty. Every upload carries a detached Ed25519 signature over the DIGEST STRING -- the ASCII
# `sha256:<64 hex>`, not the component bytes -- verified on arrival and again by THIS node when it
# loads the version, which is what matters on a replica whose state is re-loaded on every boot.
[plugins.trust]
public_keys = ["${TB_TRUST_PUBLIC_KEY}"]

# ONNX AS A GOVERNED ENTITY (decision R1). A replica registers, admits and activates every model
# its `tb-roster` clock finds verified or active in the shared schema, then plays them with
# `model_infer`. There is no sidecar and no loader: the artifact is fetched from the bucket by
# connector and digest, hashed against what the row declares, and held in an LRU session cache.
[models]
enabled = true

# Where verified artifacts are kept between loads. A replica's own disk, never shared: the digest
# is the identity, so two replicas holding the same bytes is a coincidence and not a protocol.
cache_dir = "/var/lib/orion/models"
max_cache_bytes  = 4294967296
max_loaded_bytes = 2147483648

# `referenced` warms what a workflow names by LITERAL id, and tb-match names its model with a
# `{"var": ...}` -- so it would warm nothing. The roster clock tags every registration `ladder`,
# and this is what turns that tag into a warm session at boot (Orion 1.8.1).
preload = "referenced"
preload_tags = ["ladder"]

# A competitor's ceiling, not a platform one: the largest artifact any weight class admits is
# `large` at 64 MiB, and this is that with room for the manifest's own bytes.
max_artifact_bytes = 67108864

# A 256x256 board of 7 planes is 458,752 elements; the default 1,048,576 already covers every board
# the catalogue ships, and is stated here so a future preset cannot quietly cross it.
max_input_elements  = 1048576
max_output_elements = 1048576

# THE SEASON'S CEILING, NOT THIS FILE'S turn_ms. `model_infer` asks for the claim's turn_ms and
# Orion SILENTLY CLAMPS it to this (`v.min(max_timeout_ms)`), so a node with 1000 here playing a
# season with `execution.turn_ms = 5000` gives every model one second while the match is scored as
# if it had five. No error and no trace: the models simply lose turns they were owed.
#
# 60000 is `season_rule_spec()`'s upper bound on execution.turn_ms -- the largest number an admin
# can put in a season -- so this is not generous, it is EQUAL to what the schema permits, and
# scripts/check/configs.sh asserts the equality rather than trusting it. A `db`-mode replica never
# asks for more than its own turn_ms and is unaffected either way.
max_timeout_ms = ${KALAM_MAX_TIMEOUT_MS:-60000}

[cron]
# The INNER deadline on a draining match; shutdown_force_timeout_secs above is the outer one. Equal
# to it, so neither surprises.
shutdown_timeout_secs = ${ORION_CRON_SHUTDOWN_SECS:-2700}

[engine]
# Bounds the match workflow's per-turn loop, well above max_turns: hitting this is a runaway.
max_loop_iterations = 10000

# THE FAIRNESS CONTROL, and the only one an adapter is judged by at play (decision R6). One
# evaluation -- one competitor's input adapter -- may spend this many operations. Measured against
# the ported reference adapter: 86,051 at 64x96, 129,059 at 96x96, 229,415 at 128x128, which is
# ~14 per cell and nearly flat in ant count. MUST EQUAL soma's budgets.adapter_ops_max, which is
# what admission judges by, or a model is admitted under one ceiling and played under another.
ops_budget = 1000000

# The wave channel carries `errors_only: true`, so a clean wave of hundreds of turns writes no
# trace -- the only reason `sync` is affordable on ~3000 task executions per run.
# PROMETHEUS, ON THE MAIN LISTENER. With this off, `/metrics` is not registered at all and 404s
# like any unknown route -- which is what left the Orion console's Operations dashboard (request
# rate, error rate, latency percentiles) permanently blank even once its auth was fixed.
#
# `bind_addr` is deliberately UNSET, so `/metrics` stays on the main listener where `admin_auth`
# guards it. A dedicated listener would be unauthenticated by design, and this node's admin plane
# is not something to publish a second, keyless door into. The console reaches it through the same
# gate as everything else on 8081; a scraper uses the admin key.
[metrics]
enabled = true

[trace_storage]
mode = "sync"
