# Orion config for a RUNNER: a Kalam replica on hardware the deployment does not own. Requires
# 1.9.1. Baked into this repository's image at /etc/orion/runner.toml.tmpl; the Soma half is soma's
# docker/soma.toml.tmpl. A runner is the only way Kalam runs: it reaches the platform through Soma's
# gate and holds no database credential.
#
# THIS FILE IS THE ARGUMENT FOR THE WHOLE TRACK, because of what is NOT in it. There is no
# connection string, no bucket secret and no admin token for anything but this node's own loopback
# API. What a machine needs to play rated matches is a key, a label, and the engine it plays.
#
# AND THE NUMBERS A MATCH IS PLAYED UNDER ARE NOT HERE EITHER -- not turn_ms, max_turns,
# lease_seconds, renew_every_n_turns, refusal_ceiling, replay_prefix or model_prefix. Every one of
# them arrives on the claim, from the season that owns the match, so a runner that carried its own
# copy could only disagree with the season it is playing for.
# They are absent rather than commented out ON PURPOSE: a value that is present and ignored is a
# value an operator will eventually tune, and then wonder why nothing changed.

[server]
host = "0.0.0.0"
port = 8080

# NO data_mounts: a runner binds no route. It is cron only, and what little answers on 8080 is the
# admin API its own roster clock calls and the health endpoints. NOTHING SHOULD REACH THIS PORT
# FROM OUTSIDE THE MACHINE -- docker-compose.yml publishes it on loopback only, and says so again
# for anyone who writes their own.
#
# drain is an unconditional FIXED sleep and buys a routeless node nothing; force is the REAL outer
# bound on a draining match, because the cron worker is a supervised task and the server key is its
# deadline. A shutdown costs one MATCH, not one timeout.
shutdown_drain_secs         = ${ORION_SHUTDOWN_DRAIN_SECS:-5}
shutdown_force_timeout_secs = ${ORION_SHUTDOWN_FORCE_SECS:-2700}

# DISPOSABLE, AND GONE ON EVERY START. The state holds the loaded package, this node's model
# registrations and a few hours of run records, and everything that matters is in a Postgres this
# machine cannot reach. docker-compose.yml mounts a tmpfs on its directory, so a restart -- a crash
# included -- boots from nothing: the package is applied again, the roster registers again, and no
# occurrence a dead process left `running` holds a match slot until its lease runs out.
[storage]
url = "sqlite:${ORION_STATE_PATH:-/var/lib/orion/state/state.db}"
auto_migrate = true

[vars]
# MAY A CONNECTOR DIAL A PRIVATE ADDRESS. `kalam-api`, `kalam-blobs-put` and `kalam-models` read
# this as `var://allow_private_urls`; `kalam-orion` is always allowed one,
# because it is THIS NODE'S OWN admin API and on a standalone runner that is 127.0.0.1:8080.
# One variable could never express both, which is why the exception is authored on the connector.
#
# Leave it false anywhere the runner is not on the compose bridge: `kalam-api` addresses the
# platform from wherever the runner is, and a runner that will follow a redirect into a private
# network is the wrong side of Orion's SSRF posture. web's scripts/check/configs.sh asserts it.
allow_private_urls = ${KALAM_ALLOW_PRIVATE_URLS:-false}

# The engine this runner plays, and the only rows its match clock may claim. DERIVED by
# docker/entrypoint.sh from the component in this image, never typed: a literal that agrees with
# nothing is silent everywhere -- the clock claims nothing, for ever, and the runner looks healthy
# doing it. THE CARTRIDGE IS wasm32, so this does not vary by host architecture: the digest an
# arm64 runner derives is the same one an amd64 deployment declared onto games.active_engine_digest,
# and web's scripts/check/configs.sh 1j is the assertion.
engine_digest = "${KALAM_ENGINE_DIGEST:?derived by entrypoint.sh from the component in this image}"

# THE RUNNER'S CREDENTIAL, and the whole of what a machine needs to play matches. Minted from the
# admin UI's Runners screen. Exchanged for a ten-minute `aud: runner` token, so the key itself is
# presented once per refresh and never accompanies a match write -- and revoking it on that screen
# stops this machine within one token lifetime.
# REQUIRED, AND IT SAYS SO ITSELF. `${NAME:?message}` stops the boot with that sentence and the
# file, line and column when the variable is unset or empty -- so a runner started without a key
# says which key, here, instead of failing its first token exchange a minute later. Orion reads the
# three forms (a bare reference, `:-default`, `:?message`) and skips this file's `#` comments, so a
# form may be written out in a comment without making its variable required.
runner_key = "${RUNNER_KEY:?the runner credential, minted on the admin UI Runners screen}"

# WHICH MACHINE THIS IS. The gate upserts a `runners` row on (key_id, label), so a runner
# self-registers rather than being enrolled: two machines on one key are two rows, and the label is
# what tells them apart on the Runners screen when one of them is wedged.
#
runner_label = "${RUNNER_LABEL:-runner}"

# Reported at token exchange and never enforced -- it answers "what is that machine" on the Runners
# screen and nothing else. DERIVED by entrypoint.sh from `uname -m`, because a hand-typed `amd64`
# on an arm64 Mac is a label that lies in exactly the situation the screen exists for.
arch         = "${RUNNER_ARCH}"
node_version = "${RUNNER_NODE_VERSION:-dev}"

# Read by nothing in the package: the lanes this node plays are the kalam-match channels entrypoint.sh
# lets entrypoint.sh write into the match channel's `slots` (RUNNER_CRON_WORKERS), and cron.workers below
# is those lanes plus the roster's own worker.
match_concurrency = 4

# NO poll_secs. One was carried here once and NOTHING READ IT -- the poll rate is the cron
# channel's `schedule` (`*/5 * * * * *`), which is package content, versioned with the channel and
# the same on every node that loads it. A runner cannot slow its own polling from this file, and
# pretending otherwise with a var the workflow never looks at is worse than not offering it. Polling
# less is a question about the PACKAGE: an idle poll is TWO calls over the WAN, a token exchange and
# a claim, and every match lane makes it.

# Which connector holds the model bytes. The bucket is public-read and the key below can only GET
# from it, so this is the one credential a runner holds and it buys read access and no authority.
models_bucket_connector = "kalam-models"

# What ran the adapters, recorded on every match this runner finishes. MUST EQUAL the soma node's
# `orion_version` -- a match recorded against one Orion and admitted against another is exactly
# what a re-validation sweep looks for. It is the same ORION_VERSION this image was built from,
# which is why it is not typed twice.
orion_version = "${ORION_VERSION:-1.9.1}"

# The node's own admin API, for the roster clock and for entrypoint.sh's package load. It never
# leaves this machine.
[admin_auth]
enabled = true
api_keys = ["${ORION_ADMIN_KEY:?this node's own admin key; the package is applied over it}"]

# THIS RUNNER APPLIES ITS OWN PACKAGE, and answers /readyz 503 until it is serving (Orion #345).
# entrypoint.sh generates the channels for this node's ROLE and lane count and compiles them into
# the artifact named here; the server stages it, activates it, reloads once and only then reports
# ready. Any failure stops the node non-zero.
#
# THAT MATTERS MORE ON A RUNNER THAN ANYWHERE. A node whose package did not load answers /readyz
# 200, carries no match channel, claims nothing, and is counted as capacity by everything that
# looks -- the invisible-capacity failure, on a machine nobody is watching. It used to be caught by
# a fork that polled /readyz, ran a loader, read the active channel count back and `kill -TERM 1`.
[packages]
apply = ["${KALAM_ARTIFACT:-/var/lib/orion/kalam.package.json}"]
signatures_dir = "${PLUGIN_SIG_DIR:-/sig}"

[plugins]
enabled = true

# THE CARTRIDGE IS THE ONE PLACE A THIRD PARTY'S CODE ENTERS THE PLATFORM, so this list must stay
# non-empty. Every upload carries a detached Ed25519 signature over the DIGEST STRING -- the ASCII
# `sha256:<64 hex>`, not the component bytes -- verified on arrival and again by THIS node when it
# loads the version. On a runner that is re-checked on every boot, because the state is disposable
# and the package is loaded again each time.
#
# THE SIGNATURE IS NOT IN THE PACKAGE IMAGE and cannot be: it belongs to whoever holds the trust
# key, and the image is shared by every deployment that pulls the tag. The operator copies the
# deployment's keys/signatures/ onto this machine -- README, *Run a runner*, is the step.
[plugins.trust]
public_keys = ["${TB_TRUST_PUBLIC_KEY}"]

# ONNX AS A GOVERNED ENTITY. A match runner registers, admits and activates every model its
# `kalam-roster` clock is told about -- over the gate, so it never reads model_versions itself --
# then plays them with `model_infer`. An admitting runner registers one submission at a
# time from the admission it claimed, probes it and deletes it. There is no sidecar and no loader: the artifact is
# fetched from the bucket by connector and digest, HASHED AGAINST WHAT THE ROSTER DECLARED, and
# held in an LRU session cache. That re-hash is why a public bucket and a read-only key are enough.
[models]
enabled = true

# Where verified artifacts are kept between loads. THIS MACHINE'S DISK, never shared. Size the
# Docker VM above max_cache_bytes + max_loaded_bytes or the runner will thrash on every eviction --
# README, *Run a runner*, has the sum.
cache_dir = "/var/lib/orion/models"
max_cache_bytes  = ${RUNNER_MAX_CACHE_BYTES:-4294967296}
max_loaded_bytes = ${RUNNER_MAX_LOADED_BYTES:-2147483648}

# `referenced` warms what a workflow names by LITERAL id, and kalam-match names its model with a
# `{"var": ...}` -- so it would warm nothing. The roster clock tags every registration `ladder`,
# and this is what turns that tag into a warm session at boot.
preload = "referenced"
preload_tags = ["ladder"]

# A competitor's ceiling, not a platform one: the largest artifact any weight class admits is
# `large` at 64 MiB, and this is that with room for the manifest's own bytes.
max_artifact_bytes = 67108864

# THE ONE COMPUTE GATE AT ADMISSION: Orion's five zero-filled inferences at the manifest's
# probe_dims, median inside this. EQUAL TO THE GAME'S TURN, the cartridge's limits.turn_ms, and web's
# configs.sh checks it: a model whose median inference at the largest board fits a turn can play, so
# anything stricter refuses a model the game would have let answer, and the book promises no compute
# cap but the turn. PINNED, not inherited, because this template is the one an ADMITTING runner
# (RUNNER_ROLE=admit) admits submissions under -- and the one every match runner's roster admits the
# same versions under, so a model admitted on one machine is admitted on every other. A probe over
# it goes back to be tried again (soma's admission_facts), because wall clock belongs to the machine
# that measured it; over it on every attempt, the submission expires PROBE_TOO_SLOW.
max_probe_ms = 1000

# A 256x256 board of 7 planes is 458,752 elements; the default 1,048,576 already covers every board
# an upload may be (limits.boards: 124 a side, 14,880 cells), and is stated here so a future board
# cannot quietly cross it.
max_input_elements  = 1048576
max_output_elements = 1048576

# THE SEASON'S CEILING, NOT THE GAME'S. `model_infer` asks for `turn_ms` off the claim, which
# carries the season's value, and Orion SILENTLY CLAMPS it
# to this (`v.min(max_timeout_ms)`), so a node with 1000 here playing a season with turn_ms = 5000
# gives every model one second while the match is scored as if it had five. No error, no trace: the
# models simply lose turns they were owed.
#
# 60000 is `season_rule_spec()`'s upper bound on `execution.turn_ms` -- the largest number an admin
# can put in a season -- so this is not "generous", it is EQUAL to what the schema permits, and
# web's scripts/check/configs.sh asserts that equality rather than trusting it.
max_timeout_ms = ${RUNNER_MAX_TIMEOUT_MS:-60000}

[cron]
# The INNER deadline on a draining match; shutdown_force_timeout_secs above is the outer one. Equal
# to it, so neither surprises.
shutdown_timeout_secs = ${ORION_CRON_SHUTDOWN_SECS:-2700}

# THE MATCH LANES AND ONE MORE, FOR THE ROSTER -- or, on an admitting runner, one: kalam-admit's.
# RUNNER_CRON_WORKERS is how many matches this machine plays at once, and entrypoint.sh loads exactly
# that many match lanes (the package ships four, each `forbid` on its own key, so a lane holds at
# most one worker). This is those lanes plus one, and the plus one is the roster's: Orion has ONE
# worker pool per node and a match holds its worker for the whole match, so with workers equal to
# lanes two long matches skip every roster tick (its misfire policy is `skip`), no new version is
# registered, and every lane refuses every new trial. A Mac Mini is not a fleet -- start at 2 lanes
# and watch the lease renewals before raising it.
workers = ${KALAM_CRON_WORKERS:-3}

[engine]
# Must sit above kalam-match-run's own loop max, which is what actually bounds a match's sweeps (and
# so its turns).
max_loop_iterations = 10000

# THE FAIRNESS CONTROL, and the only one an adapter is judged by at play. One
# evaluation -- one competitor's input adapter -- may spend this many operations. MUST EQUAL soma's
# budgets.adapter_ops_max, which is what admission judges by, or a model is admitted under one
# ceiling and played under another. web's scripts/check/configs.sh checks it.
ops_budget = 1000000

# PROMETHEUS, ON THE MAIN LISTENER, where admin_auth guards it. `bind_addr` is deliberately unset:
# a dedicated listener is unauthenticated by design, and this node's admin plane is not something
# to publish a second, keyless door into -- least of all on a machine outside the deployment.
[metrics]
enabled = true

# A CRON RUN ALWAYS WRITES A TRACE ROW. Orion upgrades `mode = "off"` to sync for a scheduled run,
# so this cannot be switched off, only emptied: `errors_only` keeps the result of a failed run and
# drops every other one. Every channel here sets it too; this is the default for one that does not.
[trace_storage]
mode = "sync"
errors_only = true

# ONE HOUR, the shortest the rows are useful for. The cleanup task reads this one key for both
# `traces` and `cron_occurrences`, and a busy runner writes ~30k occurrences a day (the match clock
# every 5 s, the admit clock every 10 s, the roster every 20 s), into the tmpfs above. Nothing here
# outlives a match: the result went to Soma over the gate and the replay to the bucket.
[trace_queue]
retention_hours = 1
cleanup_interval_secs = 300

# ORION'S ADMIN AUDIT LOG, which records the roster's own registrations on this node and cannot be
# turned off. Orion keeps it 90 days; a runner has no one to answer to for them.
[audit]
retention_days = 1
