# gen-kalam.py is importable, and its bytecode is not the package.
__pycache__/

# THE BUILD OUTPUT IS NOT COMMITTED. It is generated into the runner image `Dockerfile` builds --
# `ghcr.io/tiny-brains/kalam:<version>` published -- which loads it into its own node at boot.
# `connectors/` and `shared/` are the authored part and are committed. `scripts/gen-kalam.py` writes
# channels/ and workflows/ locally for the checks.
/channels/
/workflows/

# THE ENGINE IS NOT OURS TO KEEP A COPY OF. A committed copy of the cartridge can drift from the
# one ants ships, and NOTHING ERRORS when it does: the ladder plays a component ants does not ship.
# `Dockerfile` fetches the component straight from the cartridge's own GitHub release
# (`ANTS_RELEASE`, the latest by default). A local plugins/tb-ants/ is only for linting.
/plugins/

# Detached plugin signatures. A signature belongs to whoever holds the trust key, not to this
# package -- load-package.sh reads PLUGIN_SIG_DIR, and a deployment mounts them at /sig. This
# pattern stays only so a host-side signing run cannot leave one behind here.
plugins/*/*.wasm.sig

# A runner's own settings and the deployment signatures copied onto this machine. .env.example and
# .env.prod.example are the committed shapes of the first; the second belongs to whoever holds the
# trust key.
.env
.env.*
!.env.example
!.env.prod.example
keys/

# A machine's own compose override: which engine this checkout builds against (see its header).
docker-compose.override.yml
