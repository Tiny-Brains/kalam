# gen-kalam.py is importable, and its bytecode is not the package.
__pycache__/

# Detached plugin signatures -- devops/scripts/setup/sign-plugins.sh writes them from whatever key this
# machine holds. The COMPONENT is the committed artifact; the signature over it belongs to whoever
# built that release (devops/docs/deployment.md §11).
plugins/*/*.wasm.sig
