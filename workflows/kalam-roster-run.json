{
  "workflow_id": "kalam-roster-run",
  "name": "Kalam: reconcile this node's model set",
  "description": "Every version the ladder says is verified or active, registered, admitted and activated ON THIS NODE. Models are a state-database entity and each replica is its own Orion with its own state database, so a roster is per node -- and a clock that reconciles from the shared schema needs no replica list anywhere, which is what keeps any clock from ever calling a replica. One step per item per tick: registration queues admission, and a later tick activates what passed. Nothing here writes to the platform schema; its database role has SELECT and nothing else on model_versions.",
  "tags": ["kalam", "clock", "models"],
  "condition": true,
  "loop": { "counter": "i", "max": 256 },
  "tasks": [
    {
      "id": "when_roster",
      "condition": { "==": [{ "var": "temp_data.i" }, 0] },
      "tasks": [
        {
          "id": "rauth",
          "name": "Exchange the runner key for a token",
          "continue_on_error": true,
          "function": { "name": "http_call", "input": { "$from": "constants.runner_token_call" } }
        },
        {
          "id": "roster",
          "name": "What the ladder says this node should be able to play",
          "continue_on_error": true,
          "function": {
            "name": "http_call",
            "input": {
              "connector": "kalam-api",
              "method": "GET",
              "path": "/v1/runner/roster",
              "headers": { "Authorization": { "cat": ["Bearer ", { "var": "data.tok.token" }] } },
              "output": "data.rb"
            }
          }
        }
      ]
    },
    {
      "id": "more",
      "name": "Stop when the roster runs out",
      "function": {
        "name": "filter",
        "input": {
          "condition": { "<": [{ "var": "temp_data.i" }, { "var": "data.rb.n" }] },
          "on_reject": "halt"
        }
      }
    },
    {
      "id": "item",
      "name": "Take version i, and clear the last one",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.it",
              "logic": { "val": ["data", "rb", "items", { "val": ["temp_data", "i"] }] }
            },
            { "path": "temp_data.have", "unset": true },
            { "path": "temp_data.made", "unset": true },
            { "path": "temp_data.activated", "unset": true }
          ]
        }
      }
    },
    {
      "id": "have",
      "name": "Does this node know it already?",
      "continue_on_error": true,
      "function": {
        "name": "http_call",
        "input": {
          "connector": "kalam-orion",
          "method": "GET",
          "path": { "cat": ["/models/", { "var": "temp_data.it.model" }] },
          "output": "temp_data.have"
        }
      }
    },
    {
      "id": "register",
      "name": "Register it here",
      "condition": { "!": { "var": "temp_data.have.data.model_id" } },
      "continue_on_error": true,
      "function": {
        "name": "http_call",
        "input": {
          "connector": "kalam-orion",
          "method": "POST",
          "path": "/models",
          "body": {
            "manifest": { "var": "temp_data.it.manifest" },
            "artifact": {
              "connector": { "var": "metadata.vars.models_bucket_connector" },
              "key": { "var": "temp_data.it.key" },
              "digest": { "var": "temp_data.it.digest" }
            },
            "tags": ["ladder"]
          },
          "output": "temp_data.made"
        }
      }
    },
    {
      "id": "activate",
      "name": "Activate what has passed",
      "condition": {
        "and": [
          { "===": [{ "var": "temp_data.have.data.admission.state" }, "passed"] },
          { "!==": [{ "var": "temp_data.have.data.status" }, "active"] }
        ]
      },
      "continue_on_error": true,
      "function": {
        "name": "http_call",
        "input": {
          "connector": "kalam-orion",
          "method": "PATCH",
          "path": { "cat": ["/models/", { "var": "temp_data.it.model" }, "/status"] },
          "body": { "status": "active" },
          "output": "temp_data.activated"
        }
      }
    }
  ]
}
