# A PRODUCTION RUNNER's settings, for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Everything except ORION_ADMIN_KEY and RUNNER_LABEL is copied from the deployment. Every blank is
# required: the compose file refuses to start without it.

# ---- what makes this machine a runner ------------------------------------------------------------
# Minted on the admin Runners page, shown once.
RUNNER_KEY=
# The machine's name on the Runners page.
RUNNER_LABEL=

# ---- the deployment, copied from its .env --------------------------------------------------------
# https://<SITE_HOST>
SOMA_URL=
# R2_S3_ENDPOINT, character for character.
R2_S3_ENDPOINT=
#MODELS_BUCKET=tinybrains-models
# The read-only models token (Object Read on the models bucket only).
MODELS_READ_ACCESS_KEY=
MODELS_READ_SECRET_KEY=
TB_TRUST_PUBLIC_KEY=
# The deployment's keys/signatures, copied onto this machine.
RUNNER_SIG_DIR=./keys/signatures

# The release this runner plays: the kalam release built from the same ants release as the
# deployment's Soma, or this runner claims nothing, for ever.
#   KALAM_IMAGE=ghcr.io/tiny-brains/kalam:<version>
KALAM_IMAGE=

# ---- this machine's own --------------------------------------------------------------------------
#   openssl rand -hex 32
ORION_ADMIN_KEY=

# ---- capacity ------------------------------------------------------------------------------------
# docker-compose.yml's .env.example says how to size these.
RUNNER_CRON_WORKERS=2
#RUNNER_MAX_CACHE_BYTES=4294967296
#RUNNER_MAX_LOADED_BYTES=2147483648
#RUNNER_CPUS=0
#RUNNER_MEMORY=0
# The admitting runner, under --profile admit: one per deployment.
#ADMIT_CPUS=2
#ADMIT_MEMORY=0
#ADMIT_ADMIN_PORT=8091
#LOG_MAX_SIZE=20m
#LOG_MAX_FILE=5
